<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/TimeCloneHUD.uss?fileID=7433441132597879392&amp;guid=e4b5b1dcf37443a4cbc31f639de2489e&amp;type=3#TimeCloneHUD"/>
    <ui:VisualElement name="Root" class="root">
        <ui:VisualElement name="TopBar" class="top-bar">
            <ui:VisualElement class="hud-card">
                <ui:Label text="TEST CHAMBER" class="hud-caption"/>
                <ui:Label name="LevelText" text="LEVEL 01" class="hud-value"/>
            </ui:VisualElement>
            <ui:VisualElement class="hud-card">
                <ui:Label text="ELAPSED TIME" class="hud-caption"/>
                <ui:Label name="TimerText" text="00:00.0" class="hud-value"/>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="GameArea" class="game-area"/>
        <ui:VisualElement name="BottomBar" class="bottom-bar">
            <ui:Button name="Restart" text="RESTART" class="restart-button"/>
            <ui:VisualElement class="echo-controls">
                <ui:Label name="CloneText" text="ECHOES LEFT: 5" class="echo-count"/>
                <ui:Button name="Replay" text="CREATE ECHO" class="echo-button"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
