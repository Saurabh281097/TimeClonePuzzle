
/* ========================================
   TIME CLONE PUZZLE - LEVEL SELECTION UI
   Theme: ECHO LAB
   Levels: 3
======================================== */

/* Full screen background */

.menu-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;

    flex-direction: column;
    justify-content: center;
    align-items: center;

    background-color: #101827;
}

/* Main selection panel */

.menu-card {
    width: 420px;
    max-width: 90%;

    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding: 22px;

    background-color: #1C2638;

    border-width: 1px;
    border-color: #43536B;
    border-radius: 18px;
}

/* Main heading */

.menu-title {
    font-size: 28px;
    color: #F0F5FF;

    -unity-font-style: bold;
    -unity-text-align: middle-center;

    margin-bottom: 8px;
}

/* Subtitle */

.menu-subtitle {
    font-size: 14px;
    color: #94A3B8;

    -unity-text-align: middle-center;

    margin-top: 6px;
    margin-bottom: 24px;
}

/* Container holding chamber rows */

.level-grid {
    width: 100%;

    flex-direction: column;
    align-items: stretch;
    justify-content: center;
}

/* Individual row */

.level-row {
    width: 100%;

    flex-direction: row;
    justify-content: space-between;
    align-items: center;

    margin-bottom: 12px;
}

/* Center the third chamber */

.centered-row {
    justify-content: center;
}

/* Common chamber button */

.level-button {
    width: 48%;
    height: 68px;

    flex-shrink: 0;

    border-width: 1px;
    border-color: #43536B;
    border-radius: 10px;

    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

/* First unlocked chamber */

.menu-primary {
    background-color: #37E4E4;
    color: #101827;

    border-color: #37E4E4;
}

.menu-primary:hover {
    background-color: #52E0A2;
}

/* Other chambers */

.menu-secondary {
    background-color: #303D52;
    color: #F0F5FF;
}

.menu-secondary:hover {
    background-color: #43536B;
}

/* Locked buttons */

.level-button:disabled {
    background-color: #263247;
    color: #8290A5;
    border-color: #344258;
}

/* Back to menu */

.back-button {
    width: 100%;
    height: 48px;

    margin-top: 12px;

    background-color: #263247;
    color: #F0F5FF;

    border-width: 1px;
    border-color: #43536B;
    border-radius: 10px;

    font-size: 15px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.back-button:hover {
    background-color: #43536B;
}
