<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/Resources/TimeCloneComplete.uss?fileID=7433441132597879392&amp;guid=a8520b0313859c34e9eb6271928a1054&amp;type=3#TimeCloneComplete"/>
    <ui:VisualElement name="Root" class="complete-root">
        <ui:VisualElement name="CompleteCard" class="complete-card">
            <ui:Label text="✓" class="complete-icon"/>
            <ui:Label text="CHAMBER COMPLETE" class="complete-title"/>
            <ui:Label text="Timeline synchronized successfully" class="complete-subtitle"/>
            <ui:VisualElement class="complete-level-card">
                <ui:Label text="CHAMBER CLEARED" class="complete-caption"/>
                <ui:Label name="CompletedLevelText" text="LEVEL 01" class="complete-level"/>
            </ui:VisualElement>
            <ui:Button name="NextLevel" text="NEXT CHAMBER" class="complete-button complete-next"/>
            <ui:Button name="RetryLevel" text="RETRY CHAMBER" class="complete-button complete-retry"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
